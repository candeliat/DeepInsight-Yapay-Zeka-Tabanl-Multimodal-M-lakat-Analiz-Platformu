{
  "name": "deepinsight-e2e",
  "private": true,
  "description": "Web (Next.js) ve mobil (Expo web) için Playwright uçtan uca testleri; backend taklit edilir.",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:mobile": "playwright test --project=mobile",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report .out/report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
