# Bu dosyayı .env olarak kopyalayın. EXPO_PUBLIC_ ile başlayan değişkenler uygulama
# paketine gömülür — buraya gizli anahtar KOYMAYIN.
#
# Backend adresi. Telefonda Expo Go ile test ederken bilgisayarınızın yerel ağ IP'sini
# yazın (telefon "localhost"a ulaşamaz). Expo web ("w") için http://localhost:8000.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
